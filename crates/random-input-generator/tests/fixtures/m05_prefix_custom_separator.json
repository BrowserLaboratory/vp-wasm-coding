      "type": "int",
      "min": 1,
      "max": 100,
      "count": {
        "min": 3,
        "max": 3,
        "separator": ","
      },
      "prefix_count": true
    }
  },
  "expect": {
    "line": {
      "separator": ",",
      "prefix_count": true,
      "count_range": [
        3,
        3
      ],
      "int_range": [
        1,
        100
      ]
    }
  }
}
